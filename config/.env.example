# =============================================================================
# FMM Help Chatbot - environment template
# Copy to config/.env and fill in real values. NEVER commit config/.env.
# =============================================================================

APP_ENV=development
APP_NAME=FMM Knowledge and Operational Assistant
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
UI_HOST=127.0.0.1
UI_PORT=8501
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
MAX_UPLOAD_MB=200

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16 with pgvector)
# Development default uses the bundled pgserver instance started by
# scripts/dev_db.py on port 55432. Production must point at an authorized
# PostgreSQL 16 server.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/fmm_dev

# -----------------------------------------------------------------------------
# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-generate-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# -----------------------------------------------------------------------------
# Vision LLM provider selection: qwen | gemini | databricks
# The database setting (admin UI) overrides this value for newly scheduled jobs.
# There is NO automatic fallback between providers.
# -----------------------------------------------------------------------------
VISION_PROVIDER=qwen

# Provider A - Qwen3-VL (local / internal OpenAI-compatible server)
QWEN_VISION_BASE_URL=http://127.0.0.1:8001/v1
QWEN_VISION_MODEL=Qwen3-VL-8B-Instruct
QWEN_VISION_API_KEY=

# Provider B - Gemini Vision (official Gemini API)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

# Provider C - Databricks Vision (Model Serving)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_VISION_ENDPOINT=
# Databricks Model Serving vision chat endpoints use the OpenAI-compatible
# chat content-parts payload. Verified value: openai_chat
DATABRICKS_VISION_PAYLOAD_STYLE=openai_chat

# -----------------------------------------------------------------------------
# Vision inference limits
# -----------------------------------------------------------------------------
VISION_TIMEOUT_SECONDS=120
VISION_MAX_RETRIES=3
# 8192 leaves room for Gemini thinking tokens and large structured page output.
VISION_MAX_OUTPUT_TOKENS=8192
VISION_CONCURRENCY_QWEN=2
VISION_CONCURRENCY_GEMINI=2
VISION_CONCURRENCY_DATABRICKS=2

# -----------------------------------------------------------------------------
# Phase 2 - embedding and ingestion
# BAAI/bge-m3 emits 1024-dimensional dense vectors and runs through ONNX Runtime.
# Download it with: python scripts/download_models.py --backend onnx
#   python scripts/download_models.py
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_SEQ_LENGTH=1024

# Page rendering DPI for vision analysis. 200-300 is the supported range:
# 200 keeps token cost low, 300 is for small print and dense tables.
INGESTION_RENDER_DPI=200
# auto: vision only for image-heavy, scanned, low-text or visual pages
# all: analyze every page; none: text extraction only
INGESTION_VISION_MODE=auto
INGESTION_VISION_MIN_IMAGE_COVERAGE=0.015
INGESTION_VISION_LOW_TEXT_CHARS=120
INGESTION_CHUNK_MAX_CHARS=3200
INGESTION_CHUNK_OVERLAP_CHARS=400
INGESTION_PAGE_BATCH_SIZE=8

# -----------------------------------------------------------------------------
# Phase 2 - optional OCR for scanned pages
# OCR supplements the vision analysis and never replaces it. It needs the
# optional paddleocr package; when it is not installed the pages keep their
# vision-only state and ingestion continues.
# -----------------------------------------------------------------------------
INGESTION_OCR_ENABLED=false
INGESTION_OCR_BACKEND=auto
INGESTION_OCR_LANGUAGE=en
INGESTION_OCR_USE_GPU=false

# -----------------------------------------------------------------------------
# Phase 2 - retrieval (dense vectors + PostgreSQL full-text, RRF merged)
# -----------------------------------------------------------------------------
RETRIEVAL_DENSE_CANDIDATES=50
RETRIEVAL_LEXICAL_CANDIDATES=50
RETRIEVAL_TOP_K=8
RETRIEVAL_RRF_K=60
RETRIEVAL_MAX_CONTEXT_CHARS=16000

# -----------------------------------------------------------------------------
# Phase 4 - knowledge-aware retrieval and optional reranking
# RETRIEVAL_KNOWLEDGE_BOOST promotes chunks that back matched Phase 3
# knowledge (entities, workflows, rules).
# RETRIEVAL_RERANKER_ENABLED=1 requires an ONNX cross-encoder under MODEL_DIR
# with onnx/model.onnx and tokenizer.json. When disabled or unavailable the
# fused hybrid ranking is used unchanged.
# -----------------------------------------------------------------------------
RETRIEVAL_KNOWLEDGE_BOOST=true
RETRIEVAL_RERANK_CANDIDATES=30
RETRIEVAL_RERANKER_ENABLED=false
RETRIEVAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_RERANKER_MAX_LENGTH=512

# -----------------------------------------------------------------------------
# Phase 2 - grounded chat generation
# CHAT_PROVIDER: gemini | qwen | databricks
# GEMINI_CHAT_MODEL defaults to GEMINI_VISION_MODEL when left blank.
# -----------------------------------------------------------------------------
CHAT_PROVIDER=gemini
GEMINI_CHAT_MODEL=
CHAT_TEMPERATURE=0.2
CHAT_MAX_OUTPUT_TOKENS=2048
CHAT_TIMEOUT_SECONDS=120
CHAT_MAX_HISTORY_MESSAGES=12

# -----------------------------------------------------------------------------
# Phase 6 - microphone dictation (faster-whisper, optional)
# Install with: pip install -r requirements-ml.txt
# The Chat page records the prompt with the browser microphone and transcribes
# it locally; no audio leaves the host. The transcription endpoint returns 503
# when the model files are unavailable.
# -----------------------------------------------------------------------------
TRANSCRIPTION_PROVIDER=local
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
MAX_AUDIO_MB=25

# -----------------------------------------------------------------------------
# Local model and data locations (no runtime downloads; HF_HUB_OFFLINE=1 in prod)
# -----------------------------------------------------------------------------
MODEL_DIR=./models
DATA_DIR=./data
LOG_DIR=./logs
HF_HUB_OFFLINE=0
