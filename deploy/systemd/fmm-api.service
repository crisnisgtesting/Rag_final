[Unit]
Description=FMM Assistant API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fmm
Group=fmm
WorkingDirectory=/opt/fmm-assistant
EnvironmentFile=/etc/fmm-assistant/fmm.env
ExecStart=/opt/fmm-assistant/venv/bin/python -m app
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGINT

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fmm-assistant/data /opt/fmm-assistant/logs /opt/fmm-assistant/models
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fmm-api

[Install]
WantedBy=multi-user.target
